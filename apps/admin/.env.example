# CastQuest Admin Application - Environment Variables
# Copy this file to .env.local for development

# ==========================================
# Authentication
# ==========================================
# Privy App ID - Get from https://console.privy.io/
NEXT_PUBLIC_PRIVY_APP_ID=cmk4105xa00clih0c11wzxju7

# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ==========================================
# API Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:4000

# ==========================================
# Web3 Configuration
# ==========================================
# Base L2 RPC URL (Mainnet)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
# Base L2 Chain ID (8453 for mainnet, 84532 for testnet)
NEXT_PUBLIC_CHAIN_ID=8453

# ==========================================
# Admin Security
# ==========================================
# JWT Secret for admin sessions
JWT_SECRET=
# Admin API Key (for internal service calls)
ADMIN_API_KEY=

# ==========================================
# Smart Brain Configuration (Optional)
# ==========================================
# Enable AI-powered features
ENABLE_SMART_BRAIN=false
# AI Model API Key (OpenAI, Anthropic, etc.)
AI_API_KEY=

# ==========================================
# Email Configuration (Optional)
# ==========================================
# SMTP Server for notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@castquest.xyz

# ==========================================
# Feature Flags (Optional)
# ==========================================
NEXT_PUBLIC_ENABLE_RISK_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_FEE_CONTROLS=true
NEXT_PUBLIC_ENABLE_PERMISSIONS=true

# ==========================================
# Development (Optional)
# ==========================================
# Set to 'development' or 'production'
NODE_ENV=development

